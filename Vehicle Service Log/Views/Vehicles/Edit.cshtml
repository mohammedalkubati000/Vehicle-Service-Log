@model Vehicle_Service_Log.Models.Vehicle
@{
    ViewData["Title"] = "تعديل بيانات السيارة";
}

<div class="container">
    <h1>تعديل بيانات السيارة</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="text-danger" asp-validation-summary="All"></div>

        <div class="form-group mb-3">
            <label asp-for="Make" class="control-label">الشركة المصنعة</label>
            <input asp-for="Make" class="form-control" />
            <span class="text-danger" asp-validation-for="Make"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Model" class="control-label">الموديل</label>
            <input asp-for="Model" class="form-control" />
            <span class="text-danger" asp-validation-for="Model"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Year" class="control-label">سنة الصنع</label>
            <input asp-for="Year" class="form-control" />
            <span class="text-danger" asp-validation-for="Year"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="LicensePlate" class="control-label">رقم اللوحة</label>
            <input asp-for="LicensePlate" class="form-control" />
            <span class="text-danger" asp-validation-for="LicensePlate"></span>
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="تحديث البيانات" class="btn btn-warning" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">العودة للقائمة</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
