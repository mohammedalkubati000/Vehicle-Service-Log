@model Vehicle_Service_Log.Models.Vehicle
@{
    ViewData["Title"] = "حذف السيارة";
}

<div class="container">
    <h1 class="text-danger">حذف السيارة</h1>
    <h3 class="text-muted">هل أنت متأكد من رغبتك في حذف هذه السيارة؟</h3>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="Make" class="control-label">الشركة المصنعة</label>
            <input asp-for="Make" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Model" class="control-label">الموديل</label>
            <input asp-for="Model" class="form-control" readonly />
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="تأكيد الحذف" class="btn btn-danger" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">العودة للقائمة</a>
    </div>
</div>
