@model Vehicle_Service_Log.Models.ServiceLog
@{
    ViewData["Title"] = "حذف سجل الخدمة";
}

<div class="container">
    <h1 class="text-danger">حذف سجل الخدمة</h1>
    <h3 class="text-muted">هل أنت متأكد من رغبتك في حذف هذا السجل بشكل نهائي؟</h3>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="ServiceType" class="control-label">نوع الخدمة / الصيانة</label>
            <input asp-for="ServiceType" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Cost" class="control-label">التكلفة</label>
            <input asp-for="Cost" class="form-control" readonly />
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="تأكيد الحذف" class="btn btn-danger" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">العودة للقائمة</a>
    </div>
</div>
